{
    "name": "@mbs/server",
    "private": true,
    "type": "module",
    "imports": {
        "#app/*": "./src/*.ts"
    },
    "scripts": {
        "dev": "node --env-file=.env --watch src/server.ts",
        "typecheck": "tsc --noEmit",
        "test:run": "vitest run --config vitest.config.ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:pull": "drizzle-kit pull",
        "db:studio": "drizzle-kit studio",
        "seed:equipment": "node --env-file-if-exists=.env src/scripts/seed-equipment.ts",
        "seed:room-equipment": "node --env-file-if-exists=.env src/scripts/seed-room-equipment.ts"
    },
    "dependencies": {
        "@mbs/shared": "workspace:*",
        "@t3-oss/env-core": "^0.13.11",
        "better-auth": "^1.6.23",
        "drizzle-orm": "1.0.0-rc.4",
        "express": "^5.2.1",
        "http-status": "^2.1.0",
        "pg": "^8.22.0",
        "resend": "^6.17.2",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^24.13.3",
        "@types/pg": "^8.20.0",
        "drizzle-kit": "1.0.0-rc.4",
        "typescript": "^7.0.2"
    }
}
