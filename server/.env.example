# Validated at startup in src/env.ts. In production, systemd sets NODE_ENV, HOST, PORT and TZ.

# Internal origin of this API (the BFF calls it; nginx never exposes it).
SERVER_ORIGIN=http://127.0.0.1:3000
# Public origin of the web app; password reset links point here.
CLIENT_ORIGIN=http://localhost:5173
API_VERSION=v1
DATABASE_URL=postgresql://username:password@localhost:5432/mbs
# At least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Required when NODE_ENV=production (password reset emails).
RESEND_API_KEY=
# RESEND_FROM_EMAIL="Meridian <no-reply@example.com>"

# NODE_ENV=development
# HOST=127.0.0.1
# PORT=3000
