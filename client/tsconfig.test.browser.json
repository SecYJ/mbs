{
    "extends": "./tsconfig.json",
    "include": ["vitest.setup.ts", "src/**/*.browser.test.tsx", "src/**/*.ts*"],
    "exclude": ["dist"],
    "compilerOptions": {
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "types": ["vite/client", "vitest/globals"],

        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "noEmit": true
    }
}
