{
    "extends": "../tsconfig.base.json",
    "include": ["**/*.ts", "**/*.tsx"],
    "exclude": ["dist", "drizzle"],
    "compilerOptions": {
        "jsx": "react-jsx",
        "module": "ESNext",
        "paths": {
            "@/*": ["./src/*"]
        },
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "types": ["vite-plus/client"],

        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "noEmit": true
    }
}
