{
    "extends": "../tsconfig.base.json",
    "include": ["**/*.ts", "**/*.tsx"],
    "exclude": ["dist"],
    "compilerOptions": {
        "jsx": "react-jsx",
        "module": "ESNext",
        "paths": {
            "@/*": ["./src/*"]
        },
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "types": ["vite/client", "vitest/globals"],

        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "noEmit": true
    }
}
