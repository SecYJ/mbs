# Required by the client server (validated at startup in src/env.ts).
# Where the BFF reaches the Express API. Never expose it publicly.
SERVER_ORIGIN=http://127.0.0.1:3000
# Path version used by the Express API: /api/<SERVER_API_VERSION>/...
SERVER_API_VERSION=v1

# Optional.
# VITE_APP_TITLE=

# Read by `pnpm start` (production only). Defaults shown.
# HOST=127.0.0.1
# PORT=3001
