{
    "name": "mbs",
    "private": true,
    "scripts": {
        "client": "pnpm --filter @mbs/client",
        "server": "pnpm --filter @mbs/server",
        "dev": "pnpm --filter @mbs/client dev",
        "dev:server": "pnpm --filter @mbs/server dev",
        "dev:all": "concurrently --names client,server --prefix name --kill-others-on-fail \"pnpm run dev\" \"pnpm run dev:server\"",
        "build": "pnpm --filter @mbs/client build",
        "preview": "pnpm --filter @mbs/client preview",
        "prepare": "simple-git-hooks",
        "test": "pnpm --filter @mbs/client test",
        "test:run": "pnpm --filter @mbs/client test:run",
        "typecheck": "pnpm --filter @mbs/client typecheck",
        "knip": "pnpm --filter @mbs/client knip",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "db:generate": "pnpm --filter @mbs/server db:generate",
        "db:migrate": "pnpm --filter @mbs/server db:migrate",
        "db:push": "pnpm --filter @mbs/server db:push",
        "db:pull": "pnpm --filter @mbs/server db:pull",
        "db:studio": "pnpm --filter @mbs/server db:studio"
    },
    "devDependencies": {
        "@types/node": "^26.1.1",
        "concurrently": "^10.0.3",
        "lint-staged": "^16.2.6",
        "oxfmt": "^0.59.0",
        "oxlint": "^1.75.0",
        "oxlint-tsgolint": "^7.0.2001",
        "simple-git-hooks": "^2.13.1",
        "vitest": "catalog:"
    },
    "simple-git-hooks": {
        "pre-commit": "corepack pnpm exec lint-staged"
    },
    "lint-staged": {
        "*": "oxfmt --write --config .oxfmtrc.json",
        "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": "oxlint --fix"
    },
    "packageManager": "pnpm@11.3.0"
}
